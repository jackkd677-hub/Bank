    <script>
        const SUPABASE_URL = 'https://ygencncmegrpvrlnduuz.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_fFoslh81wkBZprRYBYF5Og_R6yug9aV';
        const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        const ADMIN_USER = "AdminJackkdorSan";
        const ADMIN_PASS = "AdminJacksan522553Admin";

        let currentUser = localStorage.getItem('evej_curr_user') || null;
        let currentUserData = null;
        let html5QrcodeScanner = null;

        // ຟັງຊັນສ້າງສຽງແຈ້ງເຕືອນ (Web Audio API)
        function playSound(type = 'success') {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (type === 'success') {
                    // ສຽງ ປິ້ງ! (ໂອນ/ໄດ້ຮັບເງິນສຳເລັດ)
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
                    gain.gain.setValueAtTime(0.1, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + 0.3);
                } else if (type === 'error') {
                    // ສຽງ ຕື້ດ! (ຂໍ້ຜິດພາດ/ເງິນບໍ່ພໍ)
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, ctx.currentTime);
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + 0.2);
                }
            } catch (e) {
                console.log("Audio API error:", e);
            }
        }

        window.onload = async function() {
            if (currentUser === "ADMIN") {
                showAdminPanel();
            } else if (currentUser) {
                let { data } = await db.from('users').select('*').eq('username', currentUser).single();
                if (data) { currentUserData = data; showUserDashboard(); }
                else logout();
            }
        };

        function switchAuthTab(type) {
            document.getElementById('tabLogin').classList.toggle('active', type === 'login');
            document.getElementById('tabRegister').classList.toggle('active', type === 'register');
            document.getElementById('loginForm').style.display = type === 'login' ? 'block' : 'none';
            document.getElementById('registerForm').style.display = type === 'register' ? 'block' : 'none';
        }

        async function handleRegister() {
            const u = document.getElementById('regUser').value.trim();
            const p = document.getElementById('regPass').value.trim();
            if (!u || !p) { playSound('error'); return alert('ກະລຸນາກອກຂໍ້ມູນໃຫ້ຄົບ!'); }

            const accNum = '888' + Math.floor(100000 + Math.random() * 900000);
            const { error } = await db.from('users').insert([{ username: u, password: String(p), balance: 0, acc_no: accNum }]);

            if (error) { playSound('error'); alert('❌ ຊື່ຜູ້ໃຊ້ນີ້ມີໃນລະບົບແລ້ວ!'); }
            else { playSound('success'); alert(`✅ ລົງທະບຽນສຳເລັດ!\nເລກບັນຊີ: ${accNum}`); switchAuthTab('login'); }
        }

        async function handleLogin() {
            const u = document.getElementById('loginUser').value.trim();
            const p = document.getElementById('loginPass').value.trim();

            if (u === ADMIN_USER && p === ADMIN_PASS) {
                playSound('success');
                currentUser = "ADMIN";
                localStorage.setItem('evej_curr_user', "ADMIN");
                showAdminPanel();
                return;
            }

            const { data } = await db.from('users').select('*').eq('username', u).eq('password', String(p)).single();
            if (data) {
                playSound('success');
                currentUser = u;
                currentUserData = data;
                localStorage.setItem('evej_curr_user', u);
                showUserDashboard();
            } else { playSound('error'); alert('❌ ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ!'); }
        }

        async function showUserDashboard() {
            const { data } = await db.from('users').select('*').eq('username', currentUser).single();
            if(data) currentUserData = data;

            document.getElementById('authSection').style.display = 'none';
            document.getElementById('adminSection').style.display = 'none';
            document.getElementById('dashSection').style.display = 'block';

            document.getElementById('userGreeting').innerText = `👤 ${currentUser}`;
            document.getElementById('userBalance').innerText = `${Number(currentUserData.balance).toLocaleString()} ₭`;
            document.getElementById('accNumber').innerText = `ເລກບັນຊີ: ${currentUserData.acc_no}`;
            renderUserHistory();
        }

        async function submitDeposit() {
            const amt = parseInt(document.getElementById('depositAmt').value);
            if (isNaN(amt) || amt <= 0) { playSound('error'); return alert('ຈຳນວນເງິນບໍ່ຖືກຕ້ອງ!'); }
            await db.from('requests').insert([{ username: currentUser, type: 'ฝากเงิน', amount: amt }]);
            closeModal('depositModal');
            playSound('success');
            alert('✅ ສົ່ງຄຳຮ້ອງຝາກເງິນແລ້ວ!');
        }

        async function submitWithdraw() {
            const amt = parseInt(document.getElementById('withdrawAmt').value);
            if (isNaN(amt) || amt <= 0) { playSound('error'); return alert('ຈຳນວນເງິນບໍ່ຖືກຕ້ອງ!'); }
            if (currentUserData.balance < amt) { playSound('error'); return alert('❌ ຍອດເງິນບໍ່ພໍ!'); }
            await db.from('requests').insert([{ username: currentUser, type: 'ถอนเงิน', amount: amt }]);
            closeModal('withdrawModal');
            playSound('success');
            alert('✅ ສົ່ງຄຳຮ້ອງຖອນເງິນແລ້ວ!');
        }

        async function processTransfer() {
            const targetAcc = document.getElementById('targetAccInput').value.trim();
            const amt = parseInt(document.getElementById('transferAmtInput').value);
            if (!targetAcc || isNaN(amt) || amt <= 0) { playSound('error'); return alert('ຂໍ້ມູນບໍ່ຖືກຕ້ອງ!'); }
            if (currentUserData.balance < amt) { playSound('error'); return alert('❌ ຍອດເງິນບໍ່ພໍ!'); }

            const { data: receiver } = await db.from('users').select('*').eq('acc_no', targetAcc).single();
            if (!receiver) { playSound('error'); return alert('❌ ບໍ່ພົບເລກບັນຊີຜູ້ຮັບ!'); }
            if (receiver.username === currentUser) { playSound('error'); return alert('❌ ບໍ່ສາມາດໂອນໃຫ້ຕົນເອງໄດ້!'); }

            await db.from('users').update({ balance: Number(currentUserData.balance) - amt }).eq('username', currentUser);
            await db.from('users').update({ balance: Number(receiver.balance) + amt }).eq('username', receiver.username);

            const slip = { id: 'SLIP-' + Date.now(), type: 'ໂອນເງິນ', sender: currentUser, receiver: receiver.username, amount: amt, time: new Date().toLocaleString('lo-LA') };
            await db.from('slips').insert([slip]);

            closeModal('transferModal');
            playSound('success');
            showSlipModal(slip);
            showUserDashboard();
        }

        async function renderUserHistory() {
            const container = document.getElementById('userRequestList');
            container.innerHTML = '';
            const { data: slips } = await db.from('slips').select('*').or(`sender.eq.${currentUser},receiver.eq.${currentUser}`);

            if (!slips || slips.length === 0) return container.innerHTML = '<div style="text-align:center; font-size:11px; color:#94a3b8;">ບໍ່ມີປະວັດ</div>';

            slips.reverse().forEach(s => {
                const isGain = s.receiver === currentUser;
                container.innerHTML += `
                    <div class="item-card" onclick='showSlipModal(${JSON.stringify(s)})' style="cursor:pointer;">
                        <div style="display:flex; justify-content:space-between;">
                            <b>${s.type}</b>
                            <span style="color:${isGain ? '#10b981' : '#ef4444'}; font-weight:bold;">${isGain ? '+' : '-'}${Number(s.amount).toLocaleString()} ₭</span>
                        </div>
                        <div style="font-size:10px; color:#94a3b8; margin-top:2px;">${s.time}</div>
                    </div>`;
            });
        }

