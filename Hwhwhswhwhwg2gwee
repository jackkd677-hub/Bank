            reqs.forEach(r => {
                let badge = r.status === 'pending' ? '<span class="badge badge-pending">ລໍຖ້າ</span>' :
                            r.status === 'success' ? '<span class="badge badge-success">ສຳເລັດ</span>' : '<span class="badge badge-failed">ບໍ່ສຳເລັດ</span>';
                let btns = r.status === 'pending' ? `
                    <div style="display:flex; gap:6px; margin-top:8px;">
                        <button class="btn btn-green" style="padding:4px; font-size:11px; margin:0;" onclick="handleAdminApprove(${r.id}, '${r.username}', '${r.type}', ${r.amount}, true)">✅ ອະນຸມັດ</button>
                        <button class="btn btn-red" style="padding:4px; font-size:11px; margin:0;" onclick="handleAdminApprove(${r.id}, '${r.username}', '${r.type}', ${r.amount}, false)">❌ ປະຕິເສດ</button>
                    </div>` : '';

                list.innerHTML += `<div class="item-card"><div style="display:flex; justify-content:space-between;"><span><b>👤 ${r.username}</b> (${r.type})</span>${badge}</div><div style="color:#10b981; font-weight:bold; margin-top:4px;">💰 ${Number(r.amount).toLocaleString()} ₭</div>${btns}</div>`;
            });
        }

        async function handleAdminApprove(reqId, username, type, amount, isApprove) {
            if (isApprove) {
                const { data: u } = await db.from('users').select('*').eq('username', username).single();
                if (type === 'ฝากเงิน') {
                    await db.from('users').update({ balance: Number(u.balance) + amount }).eq('username', username);
                    await db.from('slips').insert([{ id: 'SLIP-' + Date.now(), type: 'ຝາກເງິນເຂົ້າບັນຊີ', sender: 'SYSTEM', receiver: username, amount, time: new Date().toLocaleString('lo-LA') }]);
                } else if (type === 'ถอนเงิน') {
                    if (u.balance < amount) { playSound('error'); return alert('ຍອດເງິນບໍ່ພໍ!'); }
                    await db.from('users').update({ balance: Number(u.balance) - amount }).eq('username', username);
                    await db.from('slips').insert([{ id: 'SLIP-' + Date.now(), type: 'ຖອນເງິນອອກ', sender: username, receiver: 'SYSTEM', amount, time: new Date().toLocaleString('lo-LA') }]);
                }
                await db.from('requests').update({ status: 'success' }).eq('id', reqId);
                playSound('success');
            } else {
                await db.from('requests').update({ status: 'failed' }).eq('id', reqId);
                playSound('error');
            }
            renderAdminRequests();
        }

        async function renderAdminUsers() {
            const container = document.getElementById('adminUserList');
            container.innerHTML = '<div style="text-align:center; font-size:12px; color:#94a3b8;">ກຳລັງໂຫຼດ...</div>';
            const { data: users, error } = await db.from('users').select('*');
            if (error || !users) return container.innerHTML = '<div style="text-align:center; font-size:12px; color:#ef4444;">ເກີດຂໍ້ຜິດພາດ</div>';

            container.innerHTML = '';
            users.forEach(u => {
                container.innerHTML += `
                    <div class="item-card" style="margin-bottom:8px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <b style="color:#38bdf8;">👤 ${u.username}</b>
                                <div style="font-size:11px; color:#94a3b8;">ເລກບັນຊີ: ${u.acc_no}</div>
                                <div style="font-size:11px; color:#10b981;">💰 ${Number(u.balance).toLocaleString()} ₭</div>
                            </div>
                            <div style="display:flex; gap:4px;">
                                <button class="btn btn-warning" style="width:auto; padding:4px 8px; font-size:10px; margin:0;" onclick="adminEditBalance('${u.username}', ${u.balance})">✏️ ປ່ຽນເງິນ</button>
                                <button class="btn btn-red" style="width:auto; padding:4px 8px; font-size:10px; margin:0;" onclick="adminDeleteUser('${u.username}')">🗑️ ລົບ</button>
                            </div>
                        </div>
                    </div>`;
            });
        }

        async function adminCreateUser() {
            const u = document.getElementById('addAdminUser').value.trim();
            const p = document.getElementById('addAdminPass').value.trim();
            const b = parseInt(document.getElementById('addAdminBal').value) || 0;
            if (!u || !p) { playSound('error'); return alert('ກະລຸນາກອກຊື່ ແລະ ລະຫັດຜ່ານ!'); }
            const accNum = '888' + Math.floor(100000 + Math.random() * 900000);

            const { error } = await db.from('users').insert([{ username: u, password: String(p), balance: b, acc_no: accNum }]);
            if (error) { playSound('error'); alert('❌ ຊື່ຜູ້ໃຊ້ນີ້ມີແລ້ວ!'); }
            else { playSound('success'); alert('✅ ເພີ່ມ User ສຳເລັດ!'); closeModal('addUserModal'); renderAdminUsers(); }
        }

        async function adminEditBalance(username, currentBal) {
            const newBal = prompt(`ກໍານົດຍອດເງິນໃໝ່ໃຫ້ ${username}:`, currentBal);
            if (newBal !== null && !isNaN(newBal)) {
                await db.from('users').update({ balance: Number(newBal) }).eq('username', username);
                playSound('success');
                alert('✅ ອັບເດດຍອດເງິນແລ້ວ!');
                renderAdminUsers();
            }
        }

        async function adminDeleteUser(username) {
            if (confirm(`ຢືນຢັນທີ່ຈະລົບ User "${username}" ອອກຈາກລະບົບ?`)) {
                await db.from('users').delete().eq('username', username);
                playSound('success');
                alert('✅ ລົບ User ຮຽບຮ້ອຍ!');
                renderAdminUsers();
            }
        }

        function showSlipModal(slip) {
            document.getElementById('slipContent').innerHTML = `
                <div class="slip-title">📄 ສະລີບການເຮັດທຸລະກຳ</div>
                <div class="slip-row"><span>ປະເພດ:</span><b>${slip.type}</b></div>
                <div class="slip-row"><span>ຜູ້ໂອນ:</span><b>${slip.sender}</b></div>
                <div class="slip-row"><span>ຜູ້ຮັບ:</span><b>${slip.receiver}</b></div>
                <div class="slip-row"><span>ຈຳນວນເງິນ:</span><b style="color:#10b981; font-size:14px;">${Number(slip.amount).toLocaleString()} ₭</b></div>
                <div class="slip-row"><span>ເວລາ:</span><small>${slip.time}</small></div>`;
            document.getElementById('slipModal').style.display = 'flex';
        }

        function openQrModal() {
            document.getElementById('qrDisplay').innerHTML = '';
            new QRCode(document.getElementById('qrDisplay'), { text: currentUserData.acc_no, width: 140, height: 140 });
            document.getElementById('qrAccLabel').innerText = `ເລກບັນຊີ: ${currentUserData.acc_no}`;
            document.getElementById('qrModal').style.display = 'flex';
        }

        function openScanModal() {
            document.getElementById('scanModal').style.display = 'flex';
            if(!html5QrcodeScanner) {
                html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 200 });
                html5QrcodeScanner.render((decodedText) => {
                    closeScanModal();
                    openModal('transferModal');
                    document.getElementById('targetAccInput').value = decodedText;
                });
            }
        }

        function closeScanModal() {
            if(html5QrcodeScanner) { html5QrcodeScanner.clear(); html5QrcodeScanner = null; }
            document.getElementById('scanModal').style.display = 'none';
        }

        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
        function logout() {
            currentUser = null; currentUserData = null;
            localStorage.removeItem('evej_curr_user');
            document.getElementById('dashSection').style.display = 'none';
            document.getElementById('adminSection').style.display = 'none';
            document.getElementById('authSection').style.display = 'block';
        }
    </script>
</body>
</html>
