<!DOCTYPE html>
<html lang="lo">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EVEJ Bank System</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"><script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <style>
        * { font-family: "Phetsarath OT", serif !important; box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 12px; }

        .app-card { background: #1e293b; width: 100%; max-width: 440px; border-radius: 16px; padding: 20px; border: 1px solid #334155; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        .title { text-align: center; color: #38bdf8; font-size: 20px; font-weight: bold; margin-bottom: 16px; }

        input, select { width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #334155; background: #0f172a; color: white; font-size: 13px; margin-bottom: 10px; outline: none; }
        input:focus { border-color: #38bdf8; }

        .btn { width: 100%; padding: 10px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 13px; margin-top: 6px; }
        .btn-blue { background: #0284c7; color: white; }
        .btn-green { background: #10b981; color: white; }
        .btn-red { background: #ef4444; color: white; }
        .btn-warning { background: #f59e0b; color: white; }
        .btn-dark { background: #334155; color: white; }

        .tab-group { display: flex; gap: 8px; margin-bottom: 14px; }
        .tab-btn { flex: 1; padding: 8px; background: #0f172a; color: #94a3b8; border: 1px solid #334155; border-radius: 8px; cursor: pointer; text-align: center; font-size: 12px; font-weight: bold; }
        .tab-btn.active { background: #0284c7; color: white; border-color: #0284c7; }

        .balance-box { background: linear-gradient(135deg, #0284c7, #0369a1); padding: 16px; border-radius: 12px; text-align: center; margin-bottom: 14px; }
        .balance-amount { font-size: 24px; font-weight: bold; color: #ffffff; margin-top: 4px; }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); justify-content: center; align-items: center; z-index: 2000; padding: 12px; }
        .modal-box { background: #1e293b; width: 100%; max-width: 380px; padding: 16px; border-radius: 12px; border: 1px solid #334155; }

        #qrDisplay { display: flex; justify-content: center; margin: 12px 0; background: white; padding: 12px; border-radius: 8px; width: fit-content; margin-left: auto; margin-right: auto; }
        .item-card { background: #0f172a; padding: 10px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #334155; font-size: 12px; }
        
        .badge { padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; display: inline-block; }
        .badge-pending { background: #f59e0b; color: black; }
        .badge-success { background: #10b981; color: white; }
        .badge-failed { background: #ef4444; color: white; }
    </style>
</head>
<body>

    <div class="app-card">
        <!-- Auth Section -->
        <div id="authSection">
            <div class="title">🏦 EVEJ Bank System</div>
            <div class="tab-group">
                <button class="tab-btn active" id="tabLogin" onclick="switchAuthTab('login')">ເຂົ້າສູ່ລະບົບ</button>
                <button class="tab-btn" id="tabRegister" onclick="switchAuthTab('register')">ລົງທະບຽນ</button>
            </div>

            <div id="loginForm">
                <input type="text" id="loginUser" placeholder="ຊື່ຜູ້ໃຊ້ (Username)">
                <input type="password" id="loginPass" placeholder="ລະຫັດຜ່ານ (Password)">
                <button class="btn btn-blue" onclick="handleLogin()">🔑 ເຂົ້າສູ່ລະບົບ</button>
            </div>

            <div id="registerForm" style="display: none;">
                <input type="text" id="regUser" placeholder="ຊື່ຜູ້ໃຊ້ (Username)">
                <input type="password" id="regPass" placeholder="ລະຫັດຜ່ານ (Password)">
                <button class="btn btn-green" onclick="handleRegister()">📝 ລົງທະບຽນ</button>
            </div>
        </div>

        <!-- Dashboard Section (User) -->
        <div id="dashSection" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span id="userGreeting" style="font-weight: bold; font-size: 14px; color: #38bdf8;"></span>
                <button class="btn btn-red" style="width: auto; padding: 4px 10px; margin: 0; font-size: 11px;" onclick="logout()">ອອກຈາກລະບົບ</button>
            </div>

            <div class="balance-box">
                <div style="font-size: 12px; color: #e0f2fe;">ຍອດເງິນໃນບັນຊີ</div>
                <div class="balance-amount" id="userBalance">0 ₭</div>
                <div style="font-size: 11px; color: #bae6fd; margin-top: 4px;" id="accNumber">ເລກບັນຊີ: -</div>
            </div>

            <div class="grid-2">
                <button class="btn btn-green" onclick="openDepositModal()">📥 ຝາກເງິນ</button>
                <button class="btn btn-warning" onclick="openWithdrawModal()">📤 ຖອນເງິນ</button>
            </div>
            <div class="grid-2">
                <button class="btn btn-blue" onclick="openTransferModal()">💸 ໂອນເງິນ</button>
                <button class="btn btn-dark" style="background: #0284c7;" onclick="openScanModal()">📷 ສະແກນ QR</button>
            </div>
            <button class="btn btn-dark" style="margin-top: 6px;" onclick="openQrModal()">📱 ຄິວອາຂອງຂ້ອຍ (Receive QR)</button>

            <!-- ປະວັດ/ສະຖານະ ຄຳຮ້ອງ -->
            <div style="margin-top: 16px;">
                <div style="font-size: 12px; font-weight: bold; margin-bottom: 6px; color: #94a3b8;">📋 ປະວັດການຝາກ-ຖອນເງິນ:</div>
                <div id="userRequestList" style="max-height: 180px; overflow-y: auto;"></div>
            </div>
        </div>

        <!-- Admin Section -->
        <div id="adminSection" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-weight: bold; color: #f59e0b; font-size: 14px;">⚙️ Admin Control Panel</span>
                <button class="btn btn-red" style="width: auto; padding: 4px 10px; margin: 0; font-size: 11px;" onclick="logout()">ອອກ</button>
            </div>

            <div class="tab-group">
                <button class="tab-btn active" id="tabAdminReq" onclick="switchAdminTab('req')">ຄຳຮ້ອງ ຝາກ-ຖອນ</button>
                <button class="tab-btn" id="tabAdminUsers" onclick="switchAdminTab('users')">ລາຍຊື່ຜູ້ໃຊ້</button>
            </div>

            <div id="adminReqView">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 8px; color: #94a3b8;">📥 รายการ Request ຝາກ-ຖອນ:</div>
                <div id="adminRequestList" style="max-height: 320px; overflow-y: auto;"></div>
            </div>

            <div id="adminUsersView" style="display: none;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 8px; color: #94a3b8;">👥 ຈັດການຜູ້ໃຊ້:</div>
                <div id="adminUserList" style="max-height: 320px; overflow-y: auto;"></div>
            </div>
        </div>
    </div>

    <!-- Modal 1: Deposit -->
    <div class="modal" id="depositModal">
        <div class="modal-box">
            <h3 style="color: #10b981; margin-bottom: 10px;">📥 ຝາກເງິນ</h3>
            <input type="number" id="depositAmt" placeholder="ຈຳນວນເງິນທີ່ຕ້ອງການຝາກ (₭)">
            <button class="btn btn-green" onclick="submitDeposit()">ສົ່ງຄຳຮ້ອງຝາກເງິນ</button>
            <button class="btn btn-dark" onclick="closeModal('depositModal')">ປິດ</button>
        </div>
    </div>

    <!-- Modal 2: Withdraw -->
    <div class="modal" id="withdrawModal">
        <div class="modal-box">
            <h3 style="color: #f59e0b; margin-bottom: 10px;">📤 ຖອນເງິນ</h3>
            <input type="number" id="withdrawAmt" placeholder="ຈຳນວນເງິນທີ່ຕ້ອງການຖອນ (₭)">
            <button class="btn btn-warning" onclick="submitWithdraw()">ສົ່ງຄຳຮ້ອງຖອນເງິນ</button>
            <button class="btn btn-dark" onclick="closeModal('withdrawModal')">ປິດ</button>
        </div>
    </div>

    <!-- Modal 3: Transfer -->
    <div class="modal" id="transferModal">
        <div class="modal-box">
            <h3 style="color: #38bdf8; margin-bottom: 10px;">💸 ໂອນເງິນ</h3>
            <input type="text" id="targetAccInput" placeholder="ເລກບັນຊີຜູ້ຮັບ">
            <input type="number" id="transferAmtInput" placeholder="ຈຳນວນເງິນ (₭)">
            <button class="btn btn-blue" onclick="processTransfer()">ຢືນຢັນການໂອນ</button>
            <button class="btn btn-dark" onclick="closeModal('transferModal')">ປິດ</button>
        </div>
    </div>

    <!-- Modal 4: My QR -->
    <div class="modal" id="qrModal">
        <div class="modal-box" style="text-align: center;">
            <h3 style="color: #10b981;">📱 QR Code ຮັບເງິນ</h3>
            <div id="qrDisplay"></div>
            <p style="font-size: 11px; color: #94a3b8;" id="qrAccLabel"></p>
            <button class="btn btn-dark" style="margin-top: 10px;" onclick="closeModal('qrModal')">ປິດ</button>
        </div>
    </div>

    <!-- Modal 5: Scanner -->
    <div class="modal" id="scanModal">
        <div class="modal-box" style="text-align: center;">
            <h3 style="color: #38bdf8; margin-bottom: 8px;">📷 ສະແກນ QR Code</h3>
            <div id="reader"></div>
            <button class="btn btn-red" style="margin-top: 10px;" onclick="closeScanModal()">ປິດກ້ອງ</button>
        </div>
    </div>

    <script>
        const ADMIN_USER = "AdminJackkdorSan";
        const ADMIN_PASS = "AdminJacksan522553Admin";

        let dbUsers = JSON.parse(localStorage.getItem('bank_users')) || {};
        let dbRequests = JSON.parse(localStorage.getItem('bank_requests')) || [];
        let currentUser = localStorage.getItem('bank_current_user') || null;
        let qrScanner = null;

        // Sound System
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playBeep() {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(1200, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
        }

        // Init App Persist Session
        window.onload = function() {
            if (currentUser === "ADMIN") {
                showAdminPanel();
            } else if (currentUser && dbUsers[currentUser]) {
                showUserDashboard();
            } else {
                logout();
            }
        };

        function switchAuthTab(type) {
            document.getElementById('tabLogin').classList.toggle('active', type === 'login');
            document.getElementById('tabRegister').classList.toggle('active', type === 'register');
            document.getElementById('loginForm').style.display = type === 'login' ? 'block' : 'none';
            document.getElementById('registerForm').style.display = type === 'register' ? 'block' : 'none';
        }

        function handleRegister() {
            const u = document.getElementById('regUser').value.trim();
            const p = document.getElementById('regPass').value.trim();

            if (!u || !p) return alert('ກະລຸນາກອກຂໍ້ມູນໃຫ້ຄົບ!');
            if (u === ADMIN_USER) return alert('ບໍ່ສາມາດໃຊ້ຊື່ນີ້ໄດ້!');
            if (dbUsers[u]) return alert('ຊື່ຜູ້ໃຊ້ນີ້ມີໃນລະບົບແລ້ວ!');

            const accNum = '888' + Math.floor(100000 + Math.random() * 900000);
            dbUsers[u] = { pass: p, balance: 0, accNo: accNum };
            localStorage.setItem('bank_users', JSON.stringify(dbUsers));

            alert(`✅ ລົງທະບຽນສຳເລັດ!\nເລກບັນຊີຂອງທ່ານແມ່ນ: ${accNum}`);
            switchAuthTab('login');
        }

        function handleLogin() {
            const u = document.getElementById('loginUser').value.trim();
            const p = document.getElementById('loginPass').value.trim();

            if (u === ADMIN_USER && p === ADMIN_PASS) {
                currentUser = "ADMIN";
                localStorage.setItem('bank_current_user', "ADMIN");
                showAdminPanel();
                return;
            }

            if (dbUsers[u] && dbUsers[u].pass === p) {
                currentUser = u;
                localStorage.setItem('bank_current_user', u);
                showUserDashboard();
            } else {
                alert('❌ ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ!');
            }
        }

        function showUserDashboard() {
            document.getElementById('authSection').style.display = 'none';
            document.getElementById('adminSection').style.display = 'none';
            document.getElementById('dashSection').style.display = 'block';

            document.getElementById('userGreeting').innerText = `👤 ${currentUser}`;
            document.getElementById('userBalance').innerText = `${dbUsers[currentUser].balance.toLocaleString()} ₭`;
            document.getElementById('accNumber').innerText = `ເລກບັນຊີ: ${dbUsers[currentUser].accNo}`;

            renderUserRequests();
        }

        // Deposit Request
        function openDepositModal() { document.getElementById('depositModal').style.display = 'flex'; }
        function submitDeposit() {
            const amt = parseInt(document.getElementById('depositAmt').value);
            if (isNaN(amt) || amt <= 0) return alert('ກະລຸນາກອກຈຳນວນເງິນໃຫ້ຖືກຕ້ອງ!');

            const req = {
                id: Date.now(),
                user: currentUser,
                type: 'ฝากเงิน (Deposit)',
                amount: amt,
                status: 'pending' // pending, success, failed
            };

            dbRequests.unshift(req);
            localStorage.setItem('bank_requests', JSON.stringify(dbRequests));

            closeModal('depositModal');
            document.getElementById('depositAmt').value = '';
            showUserDashboard();
            alert('✅ ສົ່ງຄຳຮ້ອງຝາກເງິນແລ້ວ! ກະລຸນາຖ້າ Admin ອະນຸມັດ...');
        }

        // Withdraw Request
        function openWithdrawModal() { document.getElementById('withdrawModal').style.display = 'flex'; }
        function submitWithdraw() {
            const amt = parseInt(document.getElementById('withdrawAmt').value);
            if (isNaN(amt) || amt <= 0) return alert('ກະລຸນາກອກຈຳນວນເງິນໃຫ້ຖືກຕ້ອງ!');
            if (dbUsers[currentUser].balance < amt) return alert('❌ ຍອດເງິນໃນບັນຊີຂອງທ່ານບໍ່ພໍ!');

            const req = {
                id: Date.now(),
                user: currentUser,
                type: 'ถอนเงิน (Withdraw)',
                amount: amt,
                status: 'pending'
            };

            dbRequests.unshift(req);
            localStorage.setItem('bank_requests', JSON.stringify(dbRequests));

            closeModal('withdrawModal');
            document.getElementById('withdrawAmt').value = '';
            showUserDashboard();
            alert('✅ ສົ່ງຄຳຮ້ອງຖອນເງິນແລ້ວ! ກະລຸນາຖ້າ Admin ອະນຸມັດ...');
        }

        function renderUserRequests() {
            const container = document.getElementById('userRequestList');
            container.innerHTML = '';

            const myReqs = dbRequests.filter(r => r.user === currentUser);
            if (myReqs.length === 0) {
                container.innerHTML = '<div style="text-align:center; font-size:11px; color:#94a3b8;">ບໍ່ມີປະວັດການຝາກ-ຖອນ</div>';
                return;
            }

            myReqs.forEach(r => {
                let badgeClass = 'badge-pending';
                let statusText = '⏳ ກະລຸນາຖ້າ Admin ອະນຸມັດ...';

                if (r.status === 'success') {
                    badgeClass = 'badge-success';
                    statusText = '✅ ສຳເລັດ';
                } else if (r.status === 'failed') {
                    badgeClass = 'badge-failed';
                    statusText = '❌ ບໍ່ສຳເລັດ (ປະຕິເສດ)';
                }

                container.innerHTML += `
                    <div class="item-card">
                        <div style="display:flex; justify-content:space-between;">
                            <b>${r.type}</b>
                            <span class="badge ${badgeClass}">${statusText}</span>
                        </div>
                        <div style="margin-top:4px; font-weight:bold; color:#10b981;">💰 ${r.amount.toLocaleString()} ₭</div>
                    </div>
                `;
            });
        }

        // Admin Panel Logic
        function showAdminPanel() {
            document.getElementById('authSection').style.display = 'none';
            document.getElementById('dashSection').style.display = 'none';
            document.getElementById('adminSection').style.display = 'block';

            renderAdminRequests();
            renderAdminUserList();
        }

        function switchAdminTab(type) {
            document.getElementById('tabAdminReq').classList.toggle('active', type === 'req');
            document.getElementById('tabAdminUsers').classList.toggle('active', type === 'users');
            document.getElementById('adminReqView').style.display = type === 'req' ? 'block' : 'none';
            document.getElementById('adminUsersView').style.display = type === 'users' ? 'block' : 'none';
        }

        function renderAdminRequests() {
            const list = document.getElementById('adminRequestList');
            list.innerHTML = '';

            if (dbRequests.length === 0) {
                list.innerHTML = '<div style="text-align:center; font-size:12px; color:#94a3b8;">ບໍ່ມີຄຳຮ້ອງໃດໆ</div>';
                return;
            }

            dbRequests.forEach(r => {
                let statusBadge = r.status === 'pending' ? '<span class="badge badge-pending">ລໍຖ້າ</span>' :
                                  r.status === 'success' ? '<span class="badge badge-success">ສຳເລັດ</span>' :
                                  '<span class="badge badge-failed">ບໍ່ສຳເລັດ</span>';

                let actionBtns = '';
                if (r.status === 'pending') {
                    actionBtns = `
                        <div style="display:flex; gap:6px; margin-top:8px;">
                            <button class="btn btn-green" style="padding:4px; font-size:11px; margin:0;" onclick="handleAdminApprove(${r.id}, true)">✅ ສຳເລັດ</button>
                            <button class="btn btn-red" style="padding:4px; font-size:11px; margin:0;" onclick="handleAdminApprove(${r.id}, false)">❌ ບໍ່ສຳເລັດ</button>
                        </div>
                    `;
                }

                list.innerHTML += `
                    <div class="item-card">
                        <div style="display:flex; justify-content:space-between;">
                            <span><b>👤 ${r.user}</b> (${r.type})</span>
                            ${statusBadge}
                        </div>
                        <div style="color:#10b981; font-weight:bold; margin-top:4px;">💰 ${r.amount.toLocaleString()} ₭</div>
                        ${actionBtns}
                    </div>
                `;
            });
        }

        function handleAdminApprove(reqId, isApprove) {
            const req = dbRequests.find(r => r.id === reqId);
            if (!req || req.status !== 'pending') return;

            if (isApprove) {
                if (req.type.includes('ฝากเงิน')) {
                    dbUsers[req.user].balance += req.amount;
                } else if (req.type.includes('ถอนเงิน')) {
                    if (dbUsers[req.user].balance < req.amount) {
                        return alert('❌ ຍອດເງິນຜູ້ໃຊ້ບໍ່ພໍໃຫ້ຖອນ!');
                    }
                    dbUsers[req.user].balance -= req.amount;
                }
                req.status = 'success';
            } else {
                req.status = 'failed';
            }

            localStorage.setItem('bank_users', JSON.stringify(dbUsers));
            localStorage.setItem('bank_requests', JSON.stringify(dbRequests));

            renderAdminRequests();
            renderAdminUserList();
            alert('✅ ອັບເດດສະຖານະຮຽບຮ້ອຍແລ້ວ!');
        }

        function renderAdminUserList() {
            const list = document.getElementById('adminUserList');
            list.innerHTML = '';

            const keys = Object.keys(dbUsers);
            if (keys.length === 0) {
                list.innerHTML = '<div style="text-align:center; font-size:12px; color:#94a3b8;">ບໍ່ມີຜູ້ໃຊ້ໃນລະບົບ</div>';
                return;
            }

            keys.forEach(u => {
                const usr = dbUsers[u];
                list.innerHTML += `
                    <div class="item-card">
                        <div><b>👤 ${u}</b> (ເລກບັນຊີ: ${usr.accNo})</div>
                        <div style="color:#10b981; font-weight:bold; margin-top:2px;">💰 ${usr.balance.toLocaleString()} ₭</div>
                    </div>
                `;
            });
        }

        // Transfer Logic
        function openTransferModal(targetAcc = '') {
            document.getElementById('targetAccInput').value = targetAcc;
            document.getElementById('transferAmtInput').value = '';
            document.getElementById('transferModal').style.display = 'flex';
        }

        function processTransfer() {
            const targetAcc = document.getElementById('targetAccInput').value.trim();
            const amt = parseInt(document.getElementById('transferAmtInput').value);

            if (!targetAcc || isNaN(amt) || amt <= 0) return alert('ກະລຸນາກອກຂໍ້ມູນໃຫ້ຖືກຕ້ອງ!');
            if (dbUsers[currentUser].balance < amt) return alert('❌ ຍອດເງິນຂອງທ່ານບໍ່ພໍ!');

            let targetUser = null;
            for (let u in dbUsers) {
                if (dbUsers[u].accNo === targetAcc) targetUser = u;
            }

            if (!targetUser) return alert('❌ ບໍ່ພົບເລກບັນຊີນີ້!');
            if (targetUser === currentUser) return alert('❌ ບໍ່ສາມາດໂອນໃຫ້ຕົນເອງໄດ້!');

            dbUsers[currentUser].balance -= amt;
            dbUsers[targetUser].balance += amt;
            localStorage.setItem('bank_users', JSON.stringify(dbUsers));

            playBeep();
            closeModal('transferModal');
            showUserDashboard();
            alert(`✅ ໂອນເງິນສຳເລັດ ${amt.toLocaleString()} ₭ ໃຫ້ ${targetUser}!`);
        }

        // QR Code Modal
        function openQrModal() {
            const qrContainer = document.getElementById('qrDisplay');
            qrContainer.innerHTML = '';
            const accNo = dbUsers[currentUser].accNo;
            new QRCode(qrContainer, { text: accNo, width: 140, height: 140 });
            document.getElementById('qrAccLabel').innerText = `ເລກບັນຊີ: ${accNo}`;
            document.getElementById('qrModal').style.display = 'flex';
        }

        // QR Scanner
        function openScanModal() {
            document.getElementById('scanModal').style.display = 'flex';
            qrScanner = new Html5Qrcode("reader");
            qrScanner.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: 200 },
                (scannedText) => {
                    playBeep();
                    closeScanModal();
                    openTransferModal(scannedText);
                },
                () => {}
            ).catch(e => alert(e));
        }

        function closeScanModal() {
            if (qrScanner) {
                qrScanner.stop().then(() => {
                    document.getElementById('scanModal').style.display = 'none';
                }).catch(() => document.getElementById('scanModal').style.display = 'none');
            } else {
                document.getElementById('scanModal').style.display = 'none';
            }
        }

        function logout() {
            currentUser = null;
            localStorage.removeItem('bank_current_user');
            document.getElementById('dashSection').style.display = 'none';
            document.getElementById('adminSection').style.display = 'none';
            document.getElementById('authSection').style.display = 'block';
            document.getElementById('loginUser').value = '';
            document.getElementById('loginPass').value = '';
        }

        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    </script>
</body>
</html>
